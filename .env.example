# ==================== LLM 配置 ====================
# DeepSeek API (推荐，性价比高)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI API (备选)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ==================== Embedding 配置 ====================
# 选择嵌入模型: bge-local | openai
EMBEDDING_PROVIDER=bge-local
# BGE模型名称 (本地运行)
BGE_MODEL_NAME=BAAI/bge-large-zh-v1.5
# BGE模型本地目录（该目录存在时优先加载，不再联网；留空则从 HF 镜像下载）
BGE_LOCAL_PATH=
# OpenAI Embedding (如选择openai)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ==================== 检索配置 ====================
# 重排序模型：可填 HuggingFace 名称（如 BAAI/bge-reranker-v2-m3），
# 也可填本地模型目录（填本地目录则不会联网下载）
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 单次重排序的最大候选数（Cross-Encoder 是检索延迟瓶颈，越小越快、精度略降）
RERANK_MAX_CANDIDATES=10

# ==================== 推理运行时 ====================
# 推理设备：auto=有CUDA则用GPU；也可固定为 cpu / cuda / cuda:1
DEVICE=auto
# 是否使用FP16半精度推理（仅CUDA设备生效，显存占用约减半）
USE_FP16=true
# 重排序设备：auto=跟随DEVICE；也可固定为 cpu / cuda
# 默认cpu：嵌入模型与重排序模型同时驻留GPU会超出4GB显存，加载时会原生崩溃
RERANK_DEVICE=cpu

# ==================== 向量数据库 ====================
CHROMA_PERSIST_DIR=./data/chroma

# ==================== 爬虫配置 ====================
# 爬取请求间隔(秒)
CRAWL_DELAY=2
# 爬取深度
CRAWL_DEPTH=2
# 并发请求数
CRAWL_CONCURRENT=4
# 是否遵守robots.txt
CRAWL_ROBOTS_TXT=true
# User-Agent
CRAWL_USER_AGENT=SchoolRAG-Bot/1.0 (+https://github.com/school-rag)

# ==================== 数据存储 ====================
RAW_DATA_DIR=./data/raw
METADATA_DB=./data/metadata.db

# ==================== API配置 ====================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# ==================== 日志 ====================
LOG_LEVEL=INFO
